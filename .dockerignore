# Docker ignore file for StayEase Booking Service
# Excludes unnecessary files from Docker build context

# Maven
target/
!target/*.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
SPOTLESS_IMPLEMENTATION.md
*.md

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Other
.env
.env.local
docker-compose.yml
